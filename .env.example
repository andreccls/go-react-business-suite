# DEVELOPMENT-ONLY values. Never reuse them anywhere else.
# Copy to .env to override ports/values used by `make up` and docker compose.
# (A clean clone works WITHOUT a .env: every variable below has a dev default in docker-compose.yml.)

# "release" (the default when unset) refuses to start with a weak/default JWT_SECRET
# or a weak ADMIN_PASSWORD. The compose file sets APP_ENV=development explicitly.
APP_ENV=development
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-only-admin-password

# Business time zone: "day" boundaries of the dashboard and of date filters.
BUSINESS_TZ=America/Sao_Paulo
# Comma-separated browser origins allowed by CORS ("*" allows any). Empty = CORS off.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Compose project name (isolates containers/volumes from other repos) and host ports.
COMPOSE_PROJECT_NAME=grbs
API_PORT=8095
POSTGRES_PORT=5437
POSTGRES_PASSWORD=dev_only_postgres_password
